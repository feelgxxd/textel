{
  "name": "@feelgxxd/textel",
  "version": "0.4.0",
  "description": "Turn 3D models into animated ASCII art for the terminal and the web.",
  "keywords": [
    "ascii",
    "ascii-art",
    "3d",
    "terminal",
    "renderer",
    "gltf",
    "obj",
    "stl",
    "sdf"
  ],
  "homepage": "https://github.com/feelgxxd/textel#readme",
  "bugs": {
    "url": "https://github.com/feelgxxd/textel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feelgxxd/textel.git"
  },
  "license": "MIT",
  "author": "Berk Beken",
  "type": "module",
  "bin": {
    "textel": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdf": {
      "types": "./dist/sdf.d.ts",
      "default": "./dist/sdf.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "default": "./dist/examples.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "default": "./dist/terminal.js"
    },
    "./frames": {
      "types": "./dist/frames.d.ts",
      "default": "./dist/frames.js"
    },
    "./player": {
      "types": "./dist/browser/player.d.ts",
      "default": "./dist/textel-player.js"
    },
    "./viewer": {
      "types": "./dist/browser/viewer.d.ts",
      "default": "./dist/textel-viewer.js"
    }
  },
  "sideEffects": [
    "./dist/browser/player.js",
    "./dist/textel-player.js",
    "./dist/browser/viewer.js",
    "./dist/textel-viewer.js",
    "./src/browser/player.ts",
    "./src/browser/viewer.ts"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-browser.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "snapshots": "node test/update-snapshots.ts",
    "size": "node scripts/build-browser.ts --check",
    "demo": "node scripts/build-browser.ts && node scripts/demo.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "site": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
